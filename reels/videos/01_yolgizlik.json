  "captions": [
    { "start": 0.10, "end": 2.06, "text": "Hech kim tushunmayapti\ndeb oʻylayapsanmi?" },
    { "start": 2.47, "end": 3.95, "text": "Yolgʻiz his qilyapsanmi?", "highlight": ["Yolgʻiz"] },
    { "start": 4.46, "end": 5.68, "text": "Alloh taolo aytdi:" },
    { "start": 6.08, "end": 9.23, "text": "«Qiyinchilik bilan birga,\nalbatta, osonlik bor»", "highlight": ["osonlik"] },
    { "start": 9.68, "end": 11.76, "text": "Bu oyat ikki marta\ntakrorlandi." },
    { "start": 12.12, "end": 12.90, "text": "Ikki marta.", "highlight": ["Ikki", "marta"] },
    { "start": 13.31, "end": 14.51, "text": "Chunki U biladi —" },
    { "start": 14.84, "end": 16.93, "text": "baʼzan bir marta\nyetarli emas." },
    { "start": 17.32, "end": 17.99, "text": "Sabr qil.", "highlight": ["Sabr"] },
    { "start": 18.37, "end": 19.70, "text": "Osonlik yaqin.", "highlight": ["yaqin"] }
