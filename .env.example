# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# API-Football key (required for team search)
API_FOOTBALL_KEY=

# PostgreSQL connection URL. Leave empty for local development:
# the bot then keeps data in memory only (lost on restart).
DATABASE_URL=

# Set to true in production to refuse to start without DATABASE_URL.
REQUIRE_DATABASE=false

BOT_DISPLAY_NAME=Flash Football
DEFAULT_LANGUAGE=uz
FREE_FAVORITE_SLOTS=3
LOG_LEVEL=INFO

# Timezone for "today" and kickoff times (IANA name).
# DISPLAY_TIMEZONE=Asia/Tashkent

# How long live scores / fixture lists are shared between users before the
# API is asked again. Higher = fewer API requests (protects your daily quota).
# LIVE_CACHE_TTL_SECONDS=60
# FIXTURES_CACHE_TTL_SECONDS=300

# Port for the health-check server (hosting platforms usually set this).
# PORT=10000

# Optional automatic Telegram archive publisher.
# Use the existing Supporter Bot token; do not replace BOT_TOKEN.
SUPPORTER_BOT_TOKEN=
# Numeric Telegram channel ID (often starts with -100). Bot must be admin with posting rights.
ARCHIVE_CHANNEL_ID=
# Archive collector cadence (seconds).
ARCHIVE_LIVE_INTERVAL_SECONDS=60
ARCHIVE_FIXTURES_INTERVAL_SECONDS=300
